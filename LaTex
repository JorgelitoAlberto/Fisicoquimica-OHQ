\chapter{Cinética química}
\label{cap:cinetica}

\section{Velocidad de reacción}

\begin{concepto}[]
La \textbf{velocidad de reacción} mide qué tan rápido cambia la concentración de reactivos o productos con el tiempo. Para una reacción general $aA + bB \to cC + dD$, la velocidad se expresa de forma que sea la misma sin importar qué sustancia se esté midiendo, dividiendo cada término entre su coeficiente estequiométrico.
\end{concepto}

\begin{formula}[Expresión de la velocidad de reacción]
$$\text{Velocidad} = -\frac{1}{a}\frac{d[A]}{dt} = -\frac{1}{b}\frac{d[B]}{dt} = \frac{1}{c}\frac{d[C]}{dt} = \frac{1}{d}\frac{d[D]}{dt}$$
\end{formula}

\begin{tip}[]
El signo negativo en los reactivos existe porque su concentración \textbf{disminuye} con el tiempo, y queremos que la velocidad sea siempre un número positivo. Los productos no llevan signo negativo porque su concentración \textbf{aumenta}.
\end{tip}

\section{Ley de velocidad y orden de reacción}

\begin{concepto}[]
La \textbf{ley de velocidad} (o ecuación de velocidad) expresa cómo depende la velocidad de una reacción de las concentraciones de los reactivos, de forma \textbf{experimental} (no se puede deducir solo mirando la ecuación balanceada, salvo en reacciones elementales).
\end{concepto}

\begin{formula}[Ley de velocidad general]
$$v = k\,[A]^m[B]^n$$
\end{formula}

\begin{center}
\begin{tabular}{cl}
\toprule
\textbf{Símbolo} & \textbf{Significado} \\
\midrule
$k$ & Constante de velocidad (o constante cinética); depende de la temperatura \\
$m$ & Orden de reacción respecto al reactivo $A$ (se determina experimentalmente) \\
$n$ & Orden de reacción respecto al reactivo $B$ \\
$m+n$ & Orden \textbf{global} (u orden total) de la reacción \\
\bottomrule
\end{tabular}
\end{center}

\begin{error}[]
Asumir que los exponentes $m$ y $n$ de la ley de velocidad son iguales a los coeficientes estequiométricos $a$ y $b$ de la ecuación balanceada. Esto \textbf{solo} es válido para reacciones elementales de un solo paso; en la mayoría de los casos, los órdenes de reacción deben determinarse experimentalmente (por ejemplo, con el método de las velocidades iniciales) y no tienen por qué coincidir con los coeficientes.
\end{error}

\subsection{Determinación experimental del orden: método de velocidades iniciales}

\begin{tip}[]
Para encontrar el orden respecto a un reactivo con datos experimentales, compara dos corridas donde \textbf{solo cambia la concentración de ese reactivo} (las demás se mantienen constantes) y observa cómo cambia la velocidad inicial:
$$\frac{v_2}{v_1} = \left(\frac{[A]_2}{[A]_1}\right)^m \ \Rightarrow\ m = \frac{\log(v_2/v_1)}{\log([A]_2/[A]_1)}$$
\end{tip}

\begin{resuelto}[]
Para la reacción $2\ce{NO}(g) + \ce{O2}(g) \to 2\ce{NO2}(g)$, se obtuvieron los siguientes datos:

\begin{center}
\begin{tabular}{cccc}
\toprule
Experimento & $[\ce{NO}]_0$ (M) & $[\ce{O2}]_0$ (M) & $v_0$ (M/s) \\
\midrule
1 & 0.010 & 0.010 & $2.5\times10^{-5}$ \\
2 & 0.020 & 0.010 & $1.0\times10^{-4}$ \\
3 & 0.020 & 0.020 & $2.0\times10^{-4}$ \\
\bottomrule
\end{tabular}
\end{center}

Determina la ley de velocidad y la constante $k$.

\paso{Orden respecto a NO (comparar exp. 1 y 2, donde solo cambia [NO])}
$$\frac{v_2}{v_1} = \left(\frac{[\ce{NO}]_2}{[\ce{NO}]_1}\right)^m \ \Rightarrow\ \frac{1.0\times10^{-4}}{2.5\times10^{-5}} = \left(\frac{0.020}{0.010}\right)^m \ \Rightarrow\ 4 = 2^m \ \Rightarrow\ m=2$$

\paso{Orden respecto a O2 (comparar exp. 2 y 3, donde solo cambia [O2])}
$$\frac{v_3}{v_2} = \left(\frac{[\ce{O2}]_3}{[\ce{O2}]_2}\right)^n \ \Rightarrow\ \frac{2.0\times10^{-4}}{1.0\times10^{-4}} = \left(\frac{0.020}{0.010}\right)^n \ \Rightarrow\ 2 = 2^n \ \Rightarrow\ n=1$$

\paso{Escribir la ley de velocidad}
$$v = k[\ce{NO}]^2[\ce{O2}]^1 \qquad (\text{orden global} = 2+1 = 3)$$

\paso{Calcular $k$ usando cualquier experimento (usamos el 1)}
$$k = \frac{v_1}{[\ce{NO}]_1^2[\ce{O2}]_1} = \frac{2.5\times10^{-5}}{(0.010)^2(0.010)} = \SI{25}{M^{-2}s^{-1}}$$

\idea{El truco de este método es comparar solo pares de experimentos donde \textbf{una sola concentración cambia a la vez}; así el cociente de velocidades aísla el efecto de esa única variable y puedes despejar su exponente.}
\aplicacion{Este es probablemente el tipo de problema más frecuente del área de cinética en olimpiadas de química: identificar qué experimentos comparar es la mitad de la solución.}
\end{resuelto}

\subsection{Leyes de velocidad integradas}

\begin{concepto}[]
Las leyes de velocidad \textbf{integradas} muestran cómo cambia la concentración de un reactivo con el tiempo directamente (en vez de solo la velocidad instantánea), y permiten predecir concentraciones futuras o calcular vidas medias.
\end{concepto}

\begin{center}
\begin{tabular}{cccc}
\toprule
\textbf{Orden} & \textbf{Ley integrada} & \textbf{Gráfica lineal} & \textbf{Vida media $t_{1/2}$} \\
\midrule
0 & $[A]=[A]_0-kt$ & $[A]$ vs. $t$ & $\dfrac{[A]_0}{2k}$ \\[6pt]
1 & $\ln[A]=\ln[A]_0-kt$ & $\ln[A]$ vs. $t$ & $\dfrac{\ln 2}{k}$ \\[6pt]
2 & $\dfrac{1}{[A]}=\dfrac{1}{[A]_0}+kt$ & $\dfrac{1}{[A]}$ vs. $t$ & $\dfrac{1}{k[A]_0}$ \\
\bottomrule
\end{tabular}
\end{center}

\begin{center}
\begin{tikzpicture}
\begin{axis}[
    width=5.4cm, height=4.4cm,
    xlabel={$t$}, ylabel={$[A]$}, axis lines=left,
    xtick=\empty, ytick=\empty, title={\small Orden 0},
]
\addplot[fqAzul, thick, domain=0:3.5] {3.2-0.8*x};
\end{axis}
\end{tikzpicture}
\hspace{0.2cm}
\begin{tikzpicture}
\begin{axis}[
    width=5.4cm, height=4.4cm,
    xlabel={$t$}, ylabel={$[A]$}, axis lines=left,
    xtick=\empty, ytick=\empty, title={\small Orden 1},
]
\addplot[fqVerde, thick, domain=0:3.5, samples=60] {3.2*exp(-0.7*x)};
\end{axis}
\end{tikzpicture}
\hspace{0.2cm}
\begin{tikzpicture}
\begin{axis}[
    width=5.4cm, height=4.4cm,
    xlabel={$t$}, ylabel={$[A]$}, axis lines=left,
    xtick=\empty, ytick=\empty, title={\small Orden 2},
]
\addplot[fqNaranja, thick, domain=0:3.5, samples=60] {3.2/(1+0.9*x)};
\end{axis}
\end{tikzpicture}
\end{center}

\begin{tip}[]
Para identificar el orden de una reacción a partir de una tabla de datos $[A]$ vs. $t$ (sin que te digan el orden), grafica $[A]$, $\ln[A]$ y $1/[A]$ contra $t$: \textbf{la gráfica que salga una línea recta} te dice el orden de la reacción (0, 1 o 2 respectivamente). Es una estrategia experimental clásica en cinética.
\end{tip}

\begin{error}[]
Confundir la constante de velocidad $k$ con la constante de equilibrio $K$: son conceptos completamente distintos. $k$ tiene unidades que dependen del orden de reacción (nunca es adimensional, salvo coincidencia numérica), mientras que $K$ (bajo la convención de actividades) es adimensional.
\end{error}

\seccionpractica

\begin{propuesto}[]
Una reacción de primer orden tiene $k = \SI{3.5e-3}{s^{-1}}$. Si $[A]_0 = \SI{0.500}{M}$, ¿cuál es $[A]$ después de $\SI{300}{s}$? ¿Cuál es la vida media de la reacción?

\textit{Respuesta: $[A] = 0.500\,e^{-(3.5\times10^{-3})(300)} \approx \SI{0.175}{M}$; $t_{1/2}=\ln2/k \approx \SI{198}{s}$.}
\end{propuesto}

\begin{propuesto}[]
Para la reacción $A \to \text{productos}$, duplicar $[A]_0$ cuadruplica la velocidad inicial. ¿Cuál es el orden de la reacción respecto a $A$?

\textit{Respuesta: orden 2, porque $2^m=4 \Rightarrow m=2$.}
\end{propuesto}

\begin{resumen}[]
\begin{itemize}
    \item Velocidad de reacción: se define dividiendo cada $d[\,]/dt$ entre su coeficiente estequiométrico, con signo negativo para reactivos.
    \item Ley de velocidad: $v=k[A]^m[B]^n$; los órdenes $m,n$ se determinan \textbf{experimentalmente}, no se leen de los coeficientes (salvo reacción elemental).
    \item Método de velocidades iniciales: compara pares de experimentos donde solo cambia una concentración.
    \item Leyes integradas y sus gráficas lineales permiten identificar el orden a partir de datos de concentración vs. tiempo.
    \item Vidas medias: orden 0 depende de $[A]_0$; orden 1 es constante ($\ln2/k$); orden 2 depende de $1/[A]_0$.
\end{itemize}
\end{resumen}

