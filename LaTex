\chapter{Leyes de Faraday}
\label{cap:faraday}

\section{Corriente eléctrica y Ley de Ohm}

\begin{concepto}[]
La \textbf{corriente eléctrica} ($I$) es la cantidad de carga eléctrica que fluye a través de un conductor por unidad de tiempo. En una celda electrolítica, esta carga es transportada por electrones en el circuito externo y por iones dentro de la disolución.
\end{concepto}

\begin{formula}[Corriente y carga]
$$I = \frac{Q}{t} \qquad \Longrightarrow \qquad Q = I\,t$$
\end{formula}

donde $I$ está en amperios (A), $Q$ en culombios (C) y $t$ en segundos (s).

\begin{concepto}[: Ley de Ohm]
La \textbf{Ley de Ohm} relaciona el voltaje aplicado, la corriente que circula y la resistencia del circuito. Aunque es un tema de física de circuitos, aparece con frecuencia en problemas de electroquímica olímpica al calcular la corriente que produce una fuente de voltaje conocida en una celda de resistencia conocida.
\end{concepto}

\begin{formula}[Ley de Ohm]
$$V = IR$$
\end{formula}

con $V$ en voltios (V), $I$ en amperios (A) y $R$ en ohmios ($\Omega$).

\section{La constante de Faraday}

\begin{concepto}[]
La \textbf{constante de Faraday} ($F$) representa la carga eléctrica transportada por \textbf{1 mol de electrones}. Es el puente que conecta el mundo eléctrico (culombios, amperios) con el mundo químico (moles de sustancia).
\end{concepto}

\begin{formula}[Constante de Faraday]
$$F = \SI{96485}{C/mol\ e^-} \approx \SI{96500}{C/mol\ e^-}$$
\end{formula}

\begin{tip}[]
La constante de Faraday se obtiene multiplicando la carga de un electrón por el número de Avogadro: $F = N_A \cdot e^- = (6.022\times10^{23})(1.602\times10^{-19}\ \text{C}) \approx \SI{96485}{C/mol}$. Si alguna vez olvidas el valor exacto en examen, puedes reconstruirlo a partir de estas dos constantes fundamentales.
\end{tip}

\section{Leyes de Faraday de la electrólisis}

\begin{concepto}[]
Las \textbf{Leyes de Faraday} conectan la cantidad de carga eléctrica que pasa por una celda electrolítica con la cantidad de sustancia depositada o liberada en los electrodos.
\begin{itemize}
    \item \textbf{Primera Ley}: la masa de sustancia depositada o liberada en un electrodo es directamente proporcional a la cantidad de carga eléctrica que pasa por la celda.
    \item \textbf{Segunda Ley}: para una misma cantidad de carga, la masa de sustancias distintas depositadas es proporcional a su masa equivalente ($M/z$, donde $z$ es el número de electrones intercambiados por partícula).
\end{itemize}
\end{concepto}

\begin{formula}[Ley de Faraday combinada]
$$m = \frac{Q}{F}\cdot\frac{M}{z} = \frac{I\,t\,M}{zF}$$
\end{formula}

\begin{center}
\begin{tabular}{cl}
\toprule
\textbf{Símbolo} & \textbf{Significado} \\
\midrule
$m$ & Masa de sustancia depositada o liberada (g) \\
$Q=It$ & Carga total que pasó por la celda (C) \\
$M$ & Masa molar de la sustancia (g/mol) \\
$z$ & Número de electrones transferidos por partícula (según su semirreacción) \\
$F$ & Constante de Faraday ($\SI{96500}{C/mol}$) \\
\bottomrule
\end{tabular}
\end{center}

\section{Celdas electrolíticas}

\begin{concepto}[]
Una \textbf{celda electrolítica} usa energía eléctrica externa (una fuente de poder) para forzar una reacción redox \textbf{no espontánea} ($\Delta G>0$). Esto la distingue de una celda galvánica (o voltaica), que genera electricidad a partir de una reacción redox espontánea ($\Delta G<0$).
\end{concepto}

\begin{center}
\begin{tikzpicture}[scale=0.95]
% Vaso de precipitado (contenedor)
\draw[thick] (0,0) rectangle (6,3.0);
% Electrolito
\draw[fqAzul, fill=fqAzulClaro] (0.15,0) rectangle (5.85,2.4);
\node[fqAzul] at (3,1.0) {\footnotesize Electrolito (iones en disolución)};
% Electrodos (varillas), sobresalen del vaso
\draw[thick, fqGris] (1.6,0.15) -- (1.6,3.9);
\draw[thick, fqGris] (4.4,0.15) -- (4.4,3.9);
% Cables hacia la fuente de poder
\draw[thick] (1.6,3.9) -- (1.6,4.3) -- (2.5,4.3);
\draw[thick] (4.4,3.9) -- (4.4,4.3) -- (3.5,4.3);
% Fuente de poder externa
\draw[thick, fill=white] (2.5,4.1) rectangle (3.5,4.5);
\node at (3,4.3) {\footnotesize $-\ \ +$};
\node[above] at (3,4.55) {\footnotesize Fuente de poder externa};
% Etiquetas de electrodos, a los lados para no chocar con los cables
\node[fqGris, align=center] at (1.6,-0.55) {\footnotesize Cátodo ($-$)\\[-2pt]\footnotesize\textcolor{fqVerde}{reducción}};
\node[fqGris, align=center] at (4.4,-0.55) {\footnotesize Ánodo ($+$)\\[-2pt]\footnotesize\textcolor{fqRojo}{oxidación}};
\end{tikzpicture}
\end{center}

\begin{tip}[]
En \textbf{cualquier} celda (electrolítica o galvánica), la regla de nombres de electrodos es la misma: en el \textbf{cátodo ocurre siempre la reducción} y en el \textbf{ánodo ocurre siempre la oxidación}. Lo que cambia entre los dos tipos de celda es la polaridad (signo) de cada electrodo, no qué reacción ocurre en cuál.
\end{tip}

\begin{resuelto}[]
¿Cuántos gramos de cobre metálico se depositan en el cátodo de una celda electrolítica si se hace pasar una corriente de $\SI{2.50}{A}$ durante $\SI{1.00}{h}$ a través de una disolución de \ce{CuSO4}? ($M_{\ce{Cu}} = \SI{63.55}{g/mol}$)

\paso{Identificar la semirreacción y el valor de $z$}
$$\ce{Cu^2+ + 2e- -> Cu(s)} \qquad \Rightarrow \qquad z=2$$

\paso{Calcular la carga total}
$$t = 1.00\ \text{h} = 3600\ \text{s} \qquad Q = It = (2.50\ \text{A})(3600\ \text{s}) = \SI{9000}{C}$$

\paso{Aplicar la ley de Faraday}
$$m = \frac{Q\,M}{zF} = \frac{(9000)(63.55)}{(2)(96500)} \approx \SI{2.96}{g}$$

\idea{Cada mol de Cu depositado requiere 2 moles de electrones, así que primero conviertes carga a moles de electrones ($Q/F$), luego usas la estequiometría de la semirreacción para pasar a moles de Cu, y finalmente a gramos con la masa molar.}
\aplicacion{Este esquema —carga $\to$ moles de e$^-$ $\to$ moles de sustancia $\to$ gramos— es el "puente estequiométrico" central de toda la electroquímica olímpica; funciona igual para calcular volúmenes de gas liberado en un electrodo (usando luego $PV=nRT$).}
\end{resuelto}

\begin{error}[]
Confundir el número de electrones $z$ de la semirreacción con el número de moles de la sustancia. Por ejemplo, en \ce{Al^3+ + 3e- -> Al}, $z=3$, no $z=1$; usar el valor incorrecto de $z$ es el error más común en problemas de Faraday.
\end{error}

\seccionpractica

\begin{propuesto}[]
¿Qué corriente constante se necesita para depositar $\SI{5.00}{g}$ de plata (\ce{Ag+ + e- -> Ag}, $M=\SI{107.87}{g/mol}$) en $\SI{30.0}{min}$?

\textit{Respuesta: $Q = mFz/M \approx \SI{4475}{C}$; $I = Q/t \approx \SI{2.49}{A}$.}
\end{propuesto}

\begin{propuesto}[]
Una celda electrolítica libera gas \ce{H2} en el cátodo según \ce{2H+ + 2e- -> H2(g)}. Si pasan $\SI{4.00}{A}$ durante $\SI{965}{s}$, ¿cuántos moles de \ce{H2} se producen?

\textit{Respuesta: $Q=3860\ \text{C}$; $n(e^-)=0.0400\ \text{mol}$; $n(\ce{H2}) = 0.0200\ \text{mol}$ (por la relación 2 e$^-$ : 1 \ce{H2}).}
\end{propuesto}

\begin{resumen}[]
\begin{itemize}
    \item $Q=It$; Ley de Ohm: $V=IR$.
    \item Constante de Faraday: $F\approx\SI{96500}{C/mol\ e^-}$, la carga de un mol de electrones.
    \item Ley de Faraday combinada: $m = \dfrac{ItM}{zF}$.
    \item Cátodo: siempre reducción. Ánodo: siempre oxidación (en celdas electrolíticas y galvánicas por igual).
    \item Celda electrolítica: usa electricidad externa para forzar una reacción no espontánea.
    \item El valor de $z$ sale de la semirreacción balanceada; identifícalo con cuidado antes de calcular.
\end{itemize}
\end{resumen}

