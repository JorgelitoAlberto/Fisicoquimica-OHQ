\chapter{Termoquímica}
\label{cap:termoquimica}

\section{Funciones de estado y funciones de trayectoria}

\begin{concepto}[]
Una \textbf{función de estado} es una propiedad de un sistema que depende \textbf{únicamente} del estado actual del sistema (presión, temperatura, volumen, composición), sin importar el camino que se siguió para llegar a él. Ejemplos: presión, temperatura, volumen, energía interna ($U$), entalpía ($H$), entropía ($S$), energía de Gibbs ($G$).

Una \textbf{función de trayectoria} (o función de camino) sí depende del proceso específico seguido, no solo de los estados inicial y final. Ejemplos: calor ($q$) y trabajo ($w$).
\end{concepto}

\begin{center}
\begin{tikzpicture}[scale=1]
\draw[thick,->] (0,0) -- (6.5,0) node[right] {$V$};
\draw[thick,->] (0,0) -- (0,4) node[above] {$P$};
\filldraw[fqAzul] (1,3) circle (2pt) node[above left] {Estado inicial $A$};
\filldraw[fqVerde] (5,1) circle (2pt) node[below right] {Estado final $B$};
\draw[fqDorado, thick, ->] (1,3) .. controls (2,3) and (2,1.3) .. (5,1);
\draw[fqNaranja, thick, dashed, ->] (1,3) -- (1,1) -- (5,1);
\node[fqDorado] at (3.6,2.3) {\small camino 1};
\node[fqNaranja] at (2.2,0.6) {\small camino 2};
\end{tikzpicture}
\end{center}

\begin{tip}[]
El cambio en una función de estado, $\Delta X = X_{\text{final}} - X_{\text{inicial}}$, es \textbf{el mismo sin importar el camino} entre $A$ y $B$ en el diagrama de arriba. Esto es lo que hace posible la Ley de Hess: si $\Delta H$ solo depende de los estados inicial y final, puedes sumar o restar reacciones (caminos) como si fueran ecuaciones algebraicas y el resultado neto siempre será correcto.
\end{tip}

\section{Entalpía y su cambio}

\begin{concepto}[]
La \textbf{entalpía} ($H$) es una función de estado que representa el contenido calorífico de un sistema a presión constante. No se puede medir su valor absoluto, pero sí su \textbf{cambio}, $\Delta H$, que en un proceso a presión constante es igual al calor intercambiado con el entorno:
\end{concepto}

\begin{formula}[Definición y cambio de entalpía]
$$H = U + PV \qquad \qquad \Delta H = q_p$$
\end{formula}

\begin{itemize}
    \item Si $\Delta H < 0$: la reacción es \textbf{exotérmica} (libera calor al entorno).
    \item Si $\Delta H > 0$: la reacción es \textbf{endotérmica} (absorbe calor del entorno).
\end{itemize}

\begin{center}
\begin{tikzpicture}
\begin{axis}[
  width=7.3cm, height=5cm,
  ylabel={Entalpía $H$}, xlabel={Avance de la reacción},
  axis lines=left, xtick=\empty, ytick=\empty,
  ymin=0, ymax=5, xmin=0, xmax=4,
  title={\small Reacción exotérmica},
]
\draw[fqAzul, thick] (axis cs:0.2,3.5) -- (axis cs:1.6,3.5);
\draw[fqAzul, thick] (axis cs:2.4,1.2) -- (axis cs:3.8,1.2);
\draw[fqDorado, thick,->] (axis cs:1.6,3.5) .. controls (axis cs:2.0,4.4) .. (axis cs:2.4,1.2);
\draw[<->, fqRojo] (axis cs:3.9,3.5) -- (axis cs:3.9,1.2);
\node[fqRojo, right] at (axis cs:3.9,2.35) {\small $\Delta H<0$};
\node[fqAzul] at (axis cs:0.9,3.8) {\small Reactivos};
\node[fqAzul] at (axis cs:3.1,0.9) {\small Productos};
\end{axis}
