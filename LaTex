\end{center}

\subsection{Ley de Hess}

\begin{concepto}[]
La \textbf{Ley de Hess} establece que el $\Delta H$ de una reacción global es igual a la \textbf{suma} de los $\Delta H$ de las reacciones individuales en que se puede descomponer, sin importar si esa reacción ocurre en un paso o en varios. Es consecuencia directa de que $H$ es función de estado.
\end{concepto}

\begin{tip}[]
Para aplicar Hess: (1) escribe la reacción objetivo, (2) acomoda las reacciones dato de modo que sus reactivos y productos se cancelen hasta dar la reacción objetivo, (3) si inviertes una reacción, cambia el signo de su $\Delta H$; si la multiplicas por un coeficiente, multiplica también su $\Delta H$ por ese mismo coeficiente.
\end{tip}

\begin{resuelto}[]
Calcula $\Delta H$ para: \ce{C(s) + O2(g) -> CO2(g)}, dadas:
\begin{align*}
\ce{C(s) + 1/2 O2(g) &-> CO(g)} & \Delta H_1 &= -110.5\ \text{kJ} \\
\ce{CO(g) + 1/2 O2(g) &-> CO2(g)} & \Delta H_2 &= -283.0\ \text{kJ}
\end{align*}

\paso{Verificar que la suma directa de las dos reacciones da la reacción objetivo}
Sumando ambas ecuaciones, el \ce{CO(g)} se cancela (aparece como producto en la primera y como reactivo en la segunda), y el \ce{O2} se combina: $\frac12 + \frac12 = 1$. El resultado neto es exactamente \ce{C(s) + O2(g) -> CO2(g)}.

\paso{Sumar los $\Delta H$}
$$\Delta H = \Delta H_1 + \Delta H_2 = (-110.5) + (-283.0) = \SI{-393.5}{kJ}$$

\idea{Como $H$ es función de estado, da lo mismo quemar carbono directamente a \ce{CO2} que hacerlo en dos pasos pasando por \ce{CO}: el cambio total de entalpía es idéntico.}
\aplicacion{En la OHQ, los problemas de Hess casi siempre requieren invertir o multiplicar alguna de las reacciones dato antes de sumarlas; practica identificar rápido qué sustancia debe cancelarse.}
\end{resuelto}

\begin{error}[]
Olvidar cambiar el signo de $\Delta H$ al invertir una reacción, o no multiplicar el $\Delta H$ completo cuando se multiplica toda la ecuación por un coeficiente estequiométrico.
\end{error}

\subsection{Entalpías de formación estándar}

\begin{concepto}[]
La \textbf{entalpía estándar de formación} ($\Delta H_f^\circ$) es el cambio de entalpía al formar 1 mol de un compuesto a partir de sus elementos en su estado estándar (forma más estable a \SI{1}{atm} y \SI{25}{\celsius}). Por definición, $\Delta H_f^\circ$ de cualquier elemento en su estado estándar es \textbf{cero}.
\end{concepto}

\begin{formula}[Entalpía de reacción a partir de entalpías de formación]
$$\Delta H_{\text{rxn}}^\circ = \sum n_p\, \Delta H_f^\circ(\text{productos}) - \sum n_r\, \Delta H_f^\circ(\text{reactivos})$$
\end{formula}

\section{Entropía}

\begin{concepto}[]
La \textbf{entropía} ($S$) es una función de estado que mide el grado de desorden o el número de microestados accesibles para un sistema. Cuanto mayor es el desorden molecular (más formas de distribuir la energía y las partículas), mayor es $S$.
\end{concepto}

\begin{itemize}
    \item $S_{\text{gas}} > S_{\text{líquido}} > S_{\text{sólido}}$ para una misma sustancia.
    \item La entropía aumenta cuando aumenta el número de moles de gas en una reacción.
    \item La \textbf{Segunda Ley de la Termodinámica} establece que la entropía \textbf{total del universo} (sistema + entorno) siempre aumenta en un proceso espontáneo: $\Delta S_{\text{universo}} = \Delta S_{\text{sistema}} + \Delta S_{\text{entorno}} > 0$.
\end{itemize}

\begin{tip}[]
Para predecir el signo de $\Delta S$ de una reacción sin calcular nada, cuenta moles de gas: si $\Delta n_{\text{gas}} > 0$ (se producen más moles gaseosos de los que se consumen), entonces $\Delta S > 0$; si $\Delta n_{\text{gas}} < 0$, entonces $\Delta S < 0$.
\end{tip}

\section{Energía de Gibbs y espontaneidad}

\begin{concepto}[]
La \textbf{energía libre de Gibbs} ($G$) combina la entalpía y la entropía del sistema en una sola función de estado que permite predecir la \textbf{espontaneidad} de un proceso a presión y temperatura constantes, \textbf{sin necesidad de analizar el entorno}.
\end{concepto}

\begin{formula}[Energía de Gibbs]
$$\Delta G = \Delta H - T\Delta S$$
\end{formula}

\begin{center}
\begin{tabular}{cccl}
\toprule
$\Delta H$ & $\Delta S$ & $\Delta G$ & \textbf{Espontaneidad} \\
\midrule
$-$ & $+$ & siempre $-$ & Espontánea a cualquier $T$ \\
$+$ & $-$ & siempre $+$ & No espontánea a ninguna $T$ \\
$-$ & $-$ & depende & Espontánea a $T$ \textbf{baja} \\
$+$ & $+$ & depende & Espontánea a $T$ \textbf{alta} \\
\bottomrule
\end{tabular}
\end{center}

\begin{itemize}
    \item Si $\Delta G < 0$: el proceso es \textbf{espontáneo} (exergónico) en el sentido en que está escrito.
    \item Si $\Delta G > 0$: el proceso \textbf{no es espontáneo} tal como está escrito (sí lo es en sentido inverso).
    \item Si $\Delta G = 0$: el sistema está en \textbf{equilibrio}.
\end{itemize}

\begin{resuelto}[]
Para una reacción, $\Delta H = \SI{-92.4}{kJ}$ y $\Delta S = \SI{-198.6}{J/K}$ a $\SI{298}{K}$. ¿Es espontánea a esta temperatura? ¿A partir de qué temperatura deja de serlo?

\paso{Unificar unidades}
$\Delta S = -0.1986\ \text{kJ/K}$ (convertimos J a kJ para que coincida con $\Delta H$).

\paso{Calcular $\Delta G$ a 298 K}
$$\Delta G = \Delta H - T\Delta S = -92.4 - (298)(-0.1986) = -92.4 + 59.2 = \SI{-33.2}{kJ}$$
Como $\Delta G<0$, \textbf{sí es espontánea} a \SI{298}{K}.

\paso{Encontrar la temperatura límite (donde $\Delta G = 0$)}
$$0 = \Delta H - T\Delta S \ \Rightarrow\ T = \frac{\Delta H}{\Delta S} = \frac{-92.4}{-0.1986} \approx \SI{465}{K}$$

\paso{Interpretar}
Como $\Delta H<0$ y $\Delta S<0$ (fila 3 de la tabla), la reacción es espontánea solo a temperaturas \textbf{bajas}: para $T < \SI{465}{K}$ es espontánea, y para $T>\SI{465}{K}$ deja de serlo.

\idea{El signo de $\Delta G$ resulta de una competencia entre $\Delta H$ (favorece el orden/liberación de energía) y $-T\Delta S$ (favorece el desorden, con más peso a mayor $T$); la temperatura actúa como el "árbitro" de esa competencia.}
\aplicacion{Este tipo de análisis explica por qué reacciones exotérmicas como la solidificación del agua ocurren solas a bajas temperaturas pero se revierten (fusión) al calentar: es la misma reacción, con signos de $\Delta H$ y $\Delta S$ opuestos.}
\end{resuelto}

\begin{error}[]
Mezclar unidades de $\Delta H$ (usualmente en kJ) con $\Delta S$ (usualmente en J/K) sin convertir. Es el error numérico más frecuente al calcular $\Delta G$ en la olimpiada.
\end{error}

\seccionpractica

\begin{propuesto}[]
Dadas: \ce{S(s) + O2(g) -> SO2(g)}, $\Delta H_1 = \SI{-296.8}{kJ}$, y \ce{2 SO2(g) + O2(g) -> 2SO3(g)}, $\Delta H_2 = \SI{-198.4}{kJ}$, calcula $\Delta H$ para \ce{2S(s) + 3O2(g) -> 2SO3(g)}.

\textit{Respuesta: $\Delta H = 2\Delta H_1 + \Delta H_2 = \SI{-792.0}{kJ}$.}
\end{propuesto}

\begin{propuesto}[]
Para una reacción, $\Delta H = \SI{+45.0}{kJ}$ y $\Delta S = \SI{+125}{J/K}$. ¿Es espontánea a \SI{25}{\celsius}? ¿A qué temperatura mínima se vuelve espontánea?

\textit{Respuesta: a 298 K, $\Delta G \approx +7.7\ \text{kJ}$ (no espontánea); se vuelve espontánea para $T > 360\ \text{K}$.}
\end{propuesto}

\begin{resumen}[]
\begin{itemize}
    \item Función de estado: depende solo del estado actual ($H,S,G,U$). Función de trayectoria: depende del camino ($q,w$).
    \item Ley de Hess: los $\Delta H$ se suman como ecuaciones algebraicas; invertir cambia el signo, multiplicar escala el valor.
    \item $\Delta H_{\text{rxn}}^\circ = \sum n_p \Delta H_f^\circ(\text{productos}) - \sum n_r \Delta H_f^\circ(\text{reactivos})$.
    \item La entropía mide desorden: $S_{\text{gas}}>S_{\text{líq}}>S_{\text{sól}}$; aumenta con más moles de gas.
    \item $\Delta G = \Delta H - T\Delta S$; $\Delta G<0$ espontánea, $\Delta G>0$ no espontánea, $\Delta G=0$ equilibrio.
    \item Cuidado con las unidades: convierte $\Delta S$ a las mismas unidades de $\Delta H$ antes de calcular $\Delta G$.
\end{itemize}
\end{resumen}

