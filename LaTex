\chapter{Ley del gas ideal}
\label{cap:gasideal}

\section{El modelo de gas ideal}

\begin{concepto}[]
Un \textbf{gas ideal} es un modelo teórico en el que se asume que las partículas del gas:
\begin{itemize}
    \item No tienen volumen propio (son puntuales comparadas con el volumen del recipiente).
    \item No ejercen fuerzas de atracción ni repulsión entre sí, salvo en choques.
    \item Chocan entre sí y con las paredes del recipiente de forma \textbf{perfectamente elástica} (no pierden energía cinética).
    \item Su energía cinética promedio depende únicamente de la temperatura absoluta.
\end{itemize}
Ningún gas real cumple esto exactamente, pero a \textbf{baja presión} y \textbf{alta temperatura} (lejos del punto de condensación), la mayoría de los gases reales se comportan de forma muy cercana a un gas ideal. Este modelo es el punto de partida de toda la fisicoquímica olímpica, y en el Capítulo~\ref{cap:reales} veremos exactamente cuándo y por qué falla.
\end{concepto}

\section{Las leyes empíricas de los gases}

Antes de que existiera la ecuación general, distintos científicos encontraron relaciones \emph{parciales} entre las variables de un gas (presión $P$, volumen $V$, temperatura $T$ y cantidad de sustancia $n$), manteniendo las demás constantes. Estas leyes son casos particulares de la ley general y son muy usadas en problemas olímpicos donde \textbf{una variable no cambia}.

\subsection{Ley de Boyle-Mariotte (proceso isotérmico)}

\begin{concepto}[: Ley de Boyle]
A \textbf{temperatura constante} y cantidad de gas constante, el volumen de un gas es \textbf{inversamente proporcional} a la presión. Si comprimes un gas, su presión sube; si lo expandes, su presión baja.
\end{concepto}

\begin{formula}[Ley de Boyle]
$$P_1 V_1 = P_2 V_2 \qquad (T,\, n \text{ constantes})$$
\end{formula}

\begin{center}
\begin{tikzpicture}
\begin{axis}[
    width=7.2cm, height=5.2cm,
    xlabel={$V$ (volumen)}, ylabel={$P$ (presión)},
    axis lines=left, xmin=0, xmax=5, ymin=0, ymax=5,
    xtick=\empty, ytick=\empty,
    title={\small Isoterma de Boyle ($PV=$ cte)},
]
\addplot[fqAzul, thick, domain=0.5:5, samples=60] {2.2/x};
\node[fqAzul] at (axis cs:3.6,1.0) {\small $T$ constante};
\end{axis}
\end{tikzpicture}
\end{center}

\begin{resuelto}[]
Un gas ocupa $\SI{4.0}{L}$ a $\SI{1.5}{atm}$. Si se comprime isotérmicamente hasta $\SI{2.5}{L}$, ¿cuál es la nueva presión?

\paso{Identificar el proceso}
La temperatura y la cantidad de gas no cambian $\Rightarrow$ aplica la Ley de Boyle.

\paso{Plantear y despejar}
$$P_1V_1 = P_2V_2 \ \Rightarrow\ P_2 = \frac{P_1V_1}{V_2} = \frac{(1.5\ \text{atm})(4.0\ \text{L})}{2.5\ \text{L}} = \SI{2.4}{atm}$$

\idea{El producto $PV$ es constante mientras $T$ y $n$ no cambien; comprimir el volumen a menos de la mitad no duplica la presión porque $2.5\,\text{L}$ no es la mitad de $4.0\,\text{L}$.}
\aplicacion{En examen, la Ley de Boyle casi siempre aparece disfrazada como "un pistón comprime un gas" o "un buzo sube a la superficie" (la presión del agua disminuye y el volumen del aire en los pulmones aumenta).}
\end{resuelto}

\subsection{Ley de Charles (proceso isobárico)}

\begin{concepto}[: Ley de Charles]
A \textbf{presión constante}, el volumen de un gas es \textbf{directamente proporcional} a su temperatura \emph{absoluta} (en Kelvin, nunca en °C).
\end{concepto}

\begin{formula}[Ley de Charles]
$$\frac{V_1}{T_1} = \frac{V_2}{T_2} \qquad (P,\, n \text{ constantes})$$
\end{formula}

\begin{error}[]
Usar la temperatura en °C directamente en la fórmula. Como la relación es de \textbf{proporcionalidad directa}, si $T_1$ o $T_2$ están en Celsius, el resultado será incorrecto. \textbf{Siempre convierte a Kelvin}: $T(\text{K}) = T(^\circ\text{C}) + 273.15$.
\end{error}

\subsection{Ley de Gay-Lussac (proceso isocórico)}

\begin{concepto}[: Ley de Gay-Lussac]
A \textbf{volumen constante}, la presión de un gas es \textbf{directamente proporcional} a su temperatura absoluta. Es el principio detrás de por qué una lata de aerosol puede explotar si se calienta.
\end{concepto}

\begin{formula}[Ley de Gay-Lussac]
$$\frac{P_1}{T_1} = \frac{P_2}{T_2} \qquad (V,\, n \text{ constantes})$$
\end{formula}

