\chapter{Propiedades coligativas}
\label{cap:coligativas}

\section{¿Qué son las propiedades coligativas?}

\begin{concepto}[]
Las \textbf{propiedades coligativas} son propiedades físicas de una disolución que dependen únicamente del \textbf{número de partículas de soluto disueltas} (su concentración), y \textbf{no} de la identidad química del soluto. Las cuatro propiedades coligativas clásicas son: descenso del punto de congelación (crioscópico), aumento del punto de ebullición (ebulloscópico), descenso de la presión de vapor, y presión osmótica. En este capítulo nos enfocamos en las dos primeras, que son las que evalúa la OHQ en fisicoquímica.
\end{concepto}

\begin{tip}[]
La palabra clave es "coligativas": vienen de \textit{co-ligar}, "atadas juntas" por el número de partículas. Si disuelves 1 mol de glucosa (no se disocia) o 1 mol de \ce{NaCl} (se disocia en 2 iones), el efecto sobre estas propiedades \textbf{no es el mismo}, porque lo que importa es el número total de partículas disueltas, no los moles de fórmula inicial. Ahí es donde entra el factor de Van't Hoff, $i$.
\end{tip}

\section{Ley de Raoult y descenso de la presión de vapor}

\begin{concepto}[]
Cuando se disuelve un soluto no volátil en un disolvente, la presión de vapor de la disolución es \textbf{menor} que la del disolvente puro, porque las moléculas de soluto ocupan parte de la superficie del líquido y "estorban" el escape de moléculas de disolvente hacia la fase gaseosa.
\end{concepto}

\begin{formula}[Ley de Raoult]
$$P_{\text{disolución}} = X_{\text{disolvente}} \cdot P^\circ_{\text{disolvente}}$$
\end{formula}

donde $X_{\text{disolvente}}$ es la fracción molar del disolvente en la disolución y $P^\circ_{\text{disolvente}}$ es la presión de vapor del disolvente puro a esa temperatura.

\begin{center}
\begin{tikzpicture}
\begin{axis}[
    width=8.5cm, height=5.5cm,
    xlabel={Fracción molar del disolvente $X_{\text{disolv}}$},
    ylabel={Presión de vapor},
    axis lines=left, xmin=0, xmax=1.05, ymin=0, ymax=1.15,
    xtick={0,1}, xticklabels={0,1}, ytick=\empty,
    title={\small Ley de Raoult (disolución ideal)},
]
\addplot[fqAzul, thick, domain=0:1] {x};
\node[fqAzul] at (axis cs:0.5,0.65) {\small $P=X_{\text{disolv}}P^\circ$};
\draw[dashed, fqGris] (axis cs:1,0) -- (axis cs:1,1) node[above] {\small $P^\circ$};
\end{axis}
\end{tikzpicture}
\end{center}

\begin{tip}[]
El descenso de la presión de vapor se puede escribir directamente en términos de la fracción molar del \textbf{soluto}: $\Delta P = P^\circ - P = X_{\text{soluto}}\, P^\circ$. Esta forma es más rápida cuando el problema te da directamente los moles de soluto y disolvente.
\end{tip}

\section{Descenso crioscópico (del punto de congelación)}

\begin{concepto}[]
Al disolver un soluto en un disolvente, el punto de congelación de la disolución es \textbf{menor} que el del disolvente puro. Esto ocurre porque la presencia de partículas de soluto interfiere con el ordenamiento de las moléculas del disolvente en la red cristalina del sólido, así que se necesita una temperatura más baja para que el disolvente logre solidificar.
\end{concepto}

\begin{formula}[Descenso crioscópico]
$$\Delta T_c = i \, K_c \, m$$
\end{formula}

\begin{center}
\begin{tabular}{cl}
\toprule
\textbf{Símbolo} & \textbf{Significado} \\
\midrule
$\Delta T_c$ & Descenso del punto de congelación ($T_c^\circ - T_c$) \\
$K_c$ & Constante crioscópica molal del disolvente (propiedad tabulada, °C·kg/mol) \\
$m$ & Molalidad del soluto (mol de soluto / kg de disolvente) \\
$i$ & Factor de Van't Hoff: número de partículas en que se disocia cada unidad de soluto \\
\bottomrule
\end{tabular}
\end{center}

\begin{concepto}[: El factor de Van't Hoff]
$i$ representa cuántas partículas \textbf{reales} produce cada fórmula unitaria de soluto al disolverse:
\begin{itemize}
    \item Solutos moleculares que no se disocian (glucosa, sacarosa, urea, etanol): $i \approx 1$.
    \item \ce{NaCl -> Na+ + Cl-}: $i \approx 2$.
    \item \ce{CaCl2 -> Ca^2+ + 2Cl-}: $i \approx 3$.
    \item \ce{Al2(SO4)3 -> 2Al^3+ + 3SO4^2-}: $i \approx 5$.
\end{itemize}
En la práctica real $i$ es ligeramente menor que el valor "teórico" por efectos de asociación iónica, pero en problemas olímpicos casi siempre se usa el valor teórico salvo que se indique lo contrario.
\end{concepto}

\begin{error}[]
Olvidar el factor $i$ al trabajar con solutos iónicos (electrolitos). Es el error más común en propiedades coligativas: tratar \ce{NaCl} como si aportara la misma cantidad de partículas que la glucosa a la misma molalidad, cuando en realidad aporta el doble.
\end{error}

\begin{resuelto}[]
¿A qué temperatura se congelará una disolución preparada con $\SI{25.0}{g}$ de \ce{MgCl2} ($M = \SI{95.21}{g/mol}$) disueltos en $\SI{500}{g}$ de agua? ($K_c$ del agua $= \SI{1.86}{\celsius.kg/mol}$; el agua pura congela a $\SI{0}{\celsius}$.)

\paso{Calcular los moles y la molalidad}
$$n_{\ce{MgCl2}} = \frac{25.0\ \text{g}}{95.21\ \text{g/mol}} = 0.2626\ \text{mol}$$
$$m = \frac{0.2626\ \text{mol}}{0.500\ \text{kg}} = \SI{0.5252}{mol/kg}$$

\paso{Determinar el factor de Van't Hoff}
\ce{MgCl2 -> Mg^2+ + 2Cl-}, así que $i=3$.

\paso{Aplicar la fórmula del descenso crioscópico}
$$\Delta T_c = i\,K_c\,m = (3)(1.86)(0.5252) \approx \SI{2.93}{\celsius}$$

\paso{Calcular la temperatura de congelación final}
$$T_c = T_c^\circ - \Delta T_c = 0 - 2.93 = \SI{-2.93}{\celsius}$$

\idea{El \ce{MgCl2} triplica su efecto coligativo comparado con un soluto no iónico de la misma molalidad, porque cada unidad fórmula libera 3 iones al disolverse — esto es justamente lo que se usa en las calles para fundir hielo con sales.}
\aplicacion{Este es el tipo de problema estrella del área coligativa en la OHQ: siempre revisa primero si el soluto es un electrolito fuerte antes de sustituir en la fórmula.}
\end{resuelto}

\seccionpractica

\begin{propuesto}[]
¿Cuál disolución acuosa tendrá el punto de congelación más bajo: $\SI{0.10}{m}$ de glucosa (no electrolito) o $\SI{0.10}{m}$ de \ce{K2SO4}? Justifica sin hacer cálculos numéricos.

\textit{Respuesta: la de \ce{K2SO4}, porque se disocia en 3 iones ($i=3$) frente a $i=1$ de la glucosa, así que produce un $\Delta T_c$ tres veces mayor a la misma molalidad.}
\end{propuesto}

\begin{propuesto}[]
Se disuelven $\SI{10.0}{g}$ de un no electrolito desconocido en $\SI{200}{g}$ de agua, y la disolución congela a $\SI{-1.02}{\celsius}$. Calcula la masa molar aproximada del soluto ($K_c=\SI{1.86}{\celsius.kg/mol}$).

\textit{Respuesta: $m \approx 0.548\ \text{mol/kg}$, $n \approx 0.1097\ \text{mol}$, $M \approx \SI{91.2}{g/mol}$.}
\end{propuesto}

\begin{resumen}[]
\begin{itemize}
    \item Las propiedades coligativas dependen del \textbf{número} de partículas de soluto, no de su identidad.
    \item Ley de Raoult: $P_{\text{disolución}} = X_{\text{disolvente}} P^\circ_{\text{disolvente}}$.
    \item Descenso crioscópico: $\Delta T_c = i K_c m$, con $m$ en molalidad (mol soluto / kg disolvente).
    \item El factor de Van't Hoff $i$ cuenta las partículas reales producidas por disociación; $i=1$ para no electrolitos, $i>1$ para electrolitos.
    \item Siempre verifica si el soluto se disocia antes de aplicar la fórmula.
\end{itemize}
\end{resumen}

